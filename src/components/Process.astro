---
import content from '../data/content.json';
---

<section id="proceso" class="bg-ice py-20 md:py-28" aria-labelledby="proceso-titulo">
  <div class="mx-auto max-w-6xl px-5">
    <div class="max-w-2xl">
      <p class="inline-flex items-center gap-3 text-sm font-semibold tracking-[0.14em] text-brand uppercase">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        {content.process.eyebrow}
      </p>
      <h2 id="proceso-titulo" class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {content.process.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{content.process.subtitle}</p>
    </div>

    <ol class="mt-12 grid gap-5 lg:grid-cols-3">
      {
        content.process.steps.map((step) => (
          <li class="rounded-3xl bg-white p-6 ring-1 ring-accent/70">
            <p class="text-sm font-semibold tracking-wide text-brand">{step.number}</p>
            <h3 class="mt-3 text-xl font-semibold tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
