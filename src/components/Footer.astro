---
import content from '../data/content.json';
import ContactForm from './ContactForm';

const year = new Date().getFullYear();
---

<footer id="contacto" class="bg-navy text-white">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] lg:items-start">
    <div>
      <p class="text-sm font-semibold tracking-[0.14em] text-accent uppercase">{content.contact.eyebrow}</p>
      <h2 class="mt-3 max-w-md text-3xl font-semibold tracking-tight sm:text-4xl">{content.contact.title}</h2>
      <p class="mt-4 max-w-md text-lg leading-relaxed text-slate-300">{content.contact.subtitle}</p>

      <dl class="mt-8 space-y-3 text-sm">
        <div>
          <dt class="text-slate-400">Correo</dt>
          <dd class="mt-1">
            <a class="font-medium text-white underline decoration-white/30 underline-offset-4 hover:decoration-white" href={`mailto:${content.site.email}`}>
              {content.site.email}
            </a>
          </dd>
        </div>
      </dl>

      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2" aria-label="Redes sociales">
        {
          content.footer.social.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm font-medium text-accent hover:text-white"
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <ContactForm
      client:visible
      email={content.site.email}
      endpoint={content.contact.endpoint}
      submitLabel={content.contact.submitLabel}
    />
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-6 text-sm text-slate-300 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {content.footer.copyright}</p>
      <nav aria-label="Secundaria">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            content.footer.links.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
