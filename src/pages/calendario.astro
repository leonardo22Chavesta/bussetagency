---
import '../styles/calendario.css';
const pageTitle = 'Reserva tu Sesión de Estrategia 1-a-1 | Busset Agency';
const pageDescription =
  'Selecciona el día y la hora para tu llamada de diagnóstico gratuita y traza la hoja de ruta para llenar tu clínica de pacientes cualificados.';

const sessionPoints = [
  {
    title: 'Diagnóstico 360°',
    text: 'Identificamos los cuellos de botella en la captación y recepción de tu clínica.',
    icon: 'M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z',
  },
  {
    title: 'Plan Personalizado',
    text: 'Diseño del sistema exacto para atraer pacientes de alto valor.',
    icon: 'M3 17l6-6 4 4 8-8M15 7h6v6',
  },
  {
    title: 'Sin Compromiso',
    text: 'Si vemos que podemos ayudarte, te diremos cómo trabajar juntos; si no, te llevas el plan gratis.',
    icon: 'M12 3l8 4v5c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V7l8-4Zm-3 9 2 2 4-4',
  },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
<!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-K63SWVBB');</script>
<!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://link.bussetagency.com" />
  </head>

  <body class="min-h-screen bg-white font-sans text-ink antialiased selection:bg-blush selection:text-wine">
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K63SWVBB"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <!-- Soft ambient glows -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden bg-white">
      <div class="absolute -top-48 left-1/2 h-[520px] w-[1000px] -translate-x-1/2 rounded-full bg-blush/70 blur-[120px]"></div>
      <div class="absolute bottom-[-15%] right-[-10%] h-[420px] w-[520px] rounded-full bg-blush/50 blur-[120px]"></div>
    </div>

    <!-- Top accent bar -->
    <div class="h-1.5 w-full bg-gradient-to-r from-wine via-rose to-wine"></div>

    <main class="mx-auto max-w-6xl px-4 pb-16 pt-10 sm:px-6 sm:pt-14">
      <!-- 1. Final step badge -->
      <div class="flex justify-center">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-rose bg-white/70 px-4 py-2 text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-wine shadow-[0_4px_20px_-6px_rgba(108,21,48,0.25)] backdrop-blur-md sm:text-xs"
        >
          <span class="relative flex h-2 w-2 shrink-0">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-wine/60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-wine"></span>
          </span>
          Último paso: reserva tu sesión de estrategia 1-a-1
        </span>
      </div>

      <!-- 2. Headline -->
      <header class="mx-auto mt-8 max-w-4xl text-center">
        <h1 class="font-display text-3xl font-extrabold leading-tight text-ink sm:text-4xl lg:text-[3.1rem] lg:leading-[1.15]">
          Selecciona el Día y Hora para Tu
          <span class="relative whitespace-nowrap text-wine">
            <span class="relative z-10">Llamada de Diagnóstico</span>
            <span aria-hidden="true" class="absolute inset-x-0 bottom-1 -z-0 h-3 rounded-xs bg-blush sm:h-4"></span>
          </span>
          Gratuita
        </h1>
        <h2 class="mx-auto mt-6 max-w-2xl text-base font-normal leading-relaxed text-ink/70 sm:text-lg">
          Analizaremos el estado actual de tu clínica y trazaremos la hoja de ruta para garantizar tus
          <strong class="font-semibold text-wine">20 pacientes cualificados</strong> en los próximos 30 días.
        </h2>
      </header>

      <!-- 3. Booking widget (full width) -->
      <section class="relative mt-12">
        <div aria-hidden="true" class="absolute -inset-5 rounded-[2rem] bg-gradient-to-br from-blush via-rose/40 to-blush blur-2xl"></div>
        <div class="relative overflow-hidden rounded-2xl border border-rose bg-white shadow-[0_25px_60px_-20px_rgba(108,21,48,0.35)]">
          <div class="flex items-center justify-center gap-2 bg-wine px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-white">
            <svg class="h-4 w-4 text-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 10h18"></path>
            </svg>
            Elige tu horario · Plazas limitadas
          </div>
          <div class="leading-none">
            <iframe src="https://link.bussetagency.com/widget/booking/OdUKpY1rYtL9orHPw7Vp" allow="payment" style="width: 100%;border:none;overflow: hidden;" scrolling="no" id="OdUKpY1rYtL9orHPw7Vp_1791576834387"></iframe><br><script is:inline src="https://link.bussetagency.com/js/form_embed.js" type="text/javascript"></script>
          </div>
        </div>
      </section>

      <!-- Decision-maker note -->
      <div class="mx-auto mt-10 flex max-w-3xl items-start gap-3 rounded-xl border border-rose bg-blush/40 px-5 py-4">
        <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-wine" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
        </svg>
        <p class="text-sm leading-relaxed text-ink/80">
          Por favor, agenda solo si eres el <strong class="font-semibold text-wine">dueño, director o encargado de decisiones</strong> de la clínica.
        </p>
      </div>

      <!-- What happens in the session -->
      <section class="mt-16 lg:mt-20">
        <div class="mx-auto mb-10 flex max-w-sm items-center gap-4">
          <span class="h-px flex-1 bg-rose"></span>
          <h3 class="whitespace-nowrap text-xs font-semibold uppercase tracking-[0.2em] text-wine">¿Qué pasará en esta sesión?</h3>
          <span class="h-px flex-1 bg-rose"></span>
        </div>
        <div class="grid gap-5 sm:grid-cols-3">
          {
            sessionPoints.map((point) => (
              <article class="rounded-2xl border border-blush bg-white p-6 shadow-[0_10px_40px_-20px_rgba(108,21,48,0.3)] transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_50px_-20px_rgba(108,21,48,0.45)]">
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blush text-wine">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={point.icon} />
                  </svg>
                </div>
                <h4 class="mt-4 font-display text-lg font-bold leading-snug text-ink">{point.title}</h4>
                <p class="mt-2 text-sm leading-relaxed text-ink/65">{point.text}</p>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-blush bg-[#fdf6f7]">
      <div class="mx-auto max-w-4xl px-4 py-10 text-center text-xs leading-relaxed text-ink/50 sm:px-6">
        <nav class="mb-5 flex justify-center gap-6 text-sm">
          <a href="#" class="text-wine/80 transition hover:text-wine">Términos &amp; Condiciones</a>
          <a href="#" class="text-wine/80 transition hover:text-wine">Política de Privacidad</a>
        </nav>
        <p>
          Este sitio no forma parte del sitio web de Facebook o Facebook Inc. Además, este sitio NO está respaldado por
          Facebook de ninguna manera. FACEBOOK es una marca registrada de FACEBOOK, Inc.
        </p>
        <p class="mt-4 text-ink/40">© {year} BussetAgency.com — Derechos Reservados.</p>
      </div>
    </footer>
  </body>
</html>
