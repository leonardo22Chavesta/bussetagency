---
import content from '../data/content.json';
import TestimonialGrid from './TestimonialGrid';
---

<section id="testimonios" class="bg-white py-20 md:py-28" aria-labelledby="testimonios-titulo">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <p class="inline-flex items-center gap-3 text-sm font-semibold tracking-[0.14em] text-brand uppercase">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        {content.testimonials.eyebrow}
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
      </p>
      <h2 id="testimonios-titulo" class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        {content.testimonials.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">{content.testimonials.subtitle}</p>
    </div>

    <TestimonialGrid client:visible items={content.testimonials.items} />
  </div>
</section>
