---
import content from '../data/content.json';
---

<section aria-label="Resultados destacados" class="border-y border-accent/30 bg-ice">
  <ul class="mx-auto grid max-w-6xl sm:grid-cols-2 lg:grid-cols-4">
    {
      content.proof.map((item) => (
        <li class="px-6 py-8 text-center">
          <p class="text-3xl font-semibold tracking-tight text-brand">{item.value}</p>
          <span class="mx-auto mt-3 block h-0.5 w-8 rounded-full bg-accent" aria-hidden="true"></span>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.label}</p>
        </li>
      ))
    }
  </ul>
</section>
